<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sounddial</AssemblyName>
    <RootNamespace>AudioPuck</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows-app\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\windows-app\ConfigLoader.cs" Link="Shared\ConfigLoader.cs" />
    <Compile Include="..\windows-app\PuckProtocol.cs" Link="Shared\PuckProtocol.cs" />
    <Compile Include="..\windows-app\TransportContracts.cs" Link="Shared\TransportContracts.cs" />
    <Compile Include="..\windows-app\NetworkTransport.cs" Link="Shared\NetworkTransport.cs" />
    <Compile Include="..\windows-app\TargetController.cs" Link="Shared\TargetController.cs" />
    <Compile Include="..\windows-app\Log.cs" Link="Shared\Log.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\windows-app\config.example.toml" Link="config.toml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
